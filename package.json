{
  "name": "enveo",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun scripts/run-tests.ts",
    "test:db": "bun scripts/run-tests.ts --db",
    "typecheck": "bun run typecheck:shared && bun run typecheck:api && bun run typecheck:web && bun run typecheck:scripts",
    "typecheck:shared": "bun run --cwd packages/shared typecheck",
    "typecheck:api": "bun run --cwd packages/api typecheck",
    "typecheck:web": "bun run --cwd packages/web typecheck",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "build": "bun run build:web",
    "security:audit": "bun scripts/audit.ts",
    "image:inventory": "bun scripts/image-inventory.ts",
    "verify": "bun run typecheck && bun run test && bun run build",
    "verify:ci": "bun run typecheck && bun run test:db && bun run build && bun run security:audit",
    "dev:api": "bun run --cwd packages/api dev",
    "dev:web": "bun run --cwd packages/web dev",
    "build:web": "bun run --cwd packages/web build",
    "db:generate": "bun run --cwd packages/api db:generate",
    "db:migrate": "bun run --cwd packages/api db:migrate",
    "db:seed": "bun run --cwd packages/api db:seed",
    "auth:reset-password": "bun run --cwd packages/api auth:reset-password"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.6.3"
  }
}
