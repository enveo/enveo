# Enveo — self-hosting environment. Goes next to compose.selfhost.yml (saved as
# compose.yml outside this repo):  cp .env.selfhost.example .env
#
# The two secrets below have NO defaults: leave either empty and the stack refuses
# to start ("required variable … is missing a value"). That is on purpose — a budget
# app must not come up with a password anyone can guess.
#
# (Developing Enveo instead of running it? Use .env.example — that one is for the
# source build, docker-compose.yml.)

# --- Required ---------------------------------------------------------------

# Database password. Hex on purpose: it is interpolated into a postgres:// URL,
# where punctuation (@ : / #) would have to be percent-encoded.
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Session secret, min 32 characters. Changing it later signs everyone out (the data
# is untouched).
#   openssl rand -hex 32
BETTER_AUTH_SECRET=

# --- Optional ---------------------------------------------------------------

# Host port the app is published on. Default 8081 → http://localhost:8081
#ENVEO_PORT=8081

# Interface the port is published on. Default 127.0.0.1 = the machine itself only.
# 0.0.0.0 exposes the app to your whole network (and, on a VPS, to the internet):
#   - the FIRST person to reach it claims the owner account — registration closes only
#     once that account exists — so create yours immediately after starting the stack;
#   - over plain HTTP the session cookie has no `Secure` and travels in the clear;
#   - Docker's iptables rules BYPASS ufw/firewalld — a host firewall will not stop it.
# The safe way to reach Enveo from your phone is TLS in front of the loopback port
# (reverse proxy / tunnel / mesh VPN) plus BETTER_AUTH_URL below. Use 0.0.0.0 only
# when you mean it (NAS, trusted home LAN).
#ENVEO_BIND=0.0.0.0

# Reopen registration after the owner account exists (to add a household member).
# Remove it again once they have signed up, then: docker compose up -d
#ALLOW_SIGNUPS=1

# Public origin of the app (scheme + host, no trailing path).
# SET THIS THE MOMENT YOU PUT ENVEO BEHIND HTTPS: the session cookie is marked `Secure`
# only when this URL starts with https:// — it is what makes the cookie HTTPS-only. The
# default (http://localhost:8080) means a 90-day session cookie WITHOUT `Secure`, which
# a single plain-http:// link to the same host leaks in the clear. Sign-in works either
# way (the serving origin is always trusted), so nothing warns you if you forget.
# Also required for Google sign-in (the OAuth redirect URI is derived from it) and when
# a reverse proxy rewrites the Host header.
#BETTER_AUTH_URL=https://budget.example.com

# Extra origins allowed to call the API (CSV). Only needed when the app is browsed on
# a DIFFERENT origin than it is served from; the serving origin is always trusted.
#ALLOWED_ORIGINS=https://budget.example.com

# Google sign-in (Google Cloud console → OAuth 2.0 Client ID). Requires BETTER_AUTH_URL.
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=

# AI is optional and off by default in the app (no AI request leaves the device
# until someone opts in). A key here enables
# SERVER-side AI (screenshot import of statements, budget suggestions) — each device
# still has to opt in, and the requests are paid by this key. Without a key there is no
# server AI: budget suggestions fall back to local rules and screenshot import is
# unavailable in server mode, because it is AI-only. That does NOT disable AI on the
# device — a trusted device can use its own OpenAI key (BYOK, Settings →
# Artificial intelligence) and those
# requests go straight from the browser to OpenAI, never through this server.
# NOTE: on selfhost, server-side AI calls are not limited by Enveo. With registration
# closed (the selfhost default) that means "trusted household members spend your key";
# NEVER combine an operator key with ALLOW_SIGNUPS=1 left on on an internet-facing
# instance — that is an unmetered bill (the per-user monthly AI budget exists only on
# DEPLOYMENT=cloud). On shared instances, prefer BYOK or leave the key unset.
#OPENAI_API_KEY=
# gpt-5.6-luna = current default (cheap, image input, structured outputs); override only with a model you have checked
#OPENAI_MODEL=gpt-5.6-luna
