# Copy to .env and adjust.  cp .env.example .env

# PostgreSQL (used by docker-compose and the app image)
POSTGRES_USER=enveo
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=enveo

# Optional: OpenAI — enriches Smart Quick-Add + expense import from screenshots
# (Apple Wallet / bank history). Empty = LLM features disabled,
# quick-add works in rules-only mode (no cost / no network).
OPENAI_API_KEY=
# gpt-5.5 = best screenshot-reading quality; gpt-5.4-mini = ~7x cheaper
OPENAI_MODEL=gpt-5.5

# Local development (api outside docker) — points at the docker-compose database:
# DATABASE_URL=postgres://enveo:change_this_password@127.0.0.1:5432/enveo

# --- Security (CORS + CSRF origin-guard) ---
# ALLOWED_ORIGINS = CSV of app origin(s) allowed for cross-origin mutations.
# In prod set it to the origin the app is exposed on (e.g. its URL inside your
# private network perimeter, such as a VPN hostname);
# BETTER_AUTH_URL is also treated as an app origin. Empty = same-origin only.
# ALLOWED_ORIGINS=https://app.example.com

# --- Authentication (better-auth) ---
# AUTH_MODE=none (default) = no login, behavior as before (the private network
# perimeter, e.g. a VPN, is the only boundary). AUTH_MODE=multi = Google login + budget per user.
# AUTH_MODE=none
# Session signing secret — REQUIRED in multi mode (e.g. `openssl rand -hex 32`).
# BETTER_AUTH_SECRET=
# Public base URL of the app (origin), used for the OAuth redirect.
# BETTER_AUTH_URL=http://localhost:8080
# Google OAuth (Google Cloud console → OAuth 2.0 Client ID).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DEV_LOGIN=1 enables email+password login — dev/tests (e2e) ONLY, never in prod.
# DEV_LOGIN=
