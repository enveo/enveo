{
  // Repository tooling (scripts/*.ts): the test orchestrator and the audit-policy gate.
  // These files ARE the verification contract, so they are typechecked like product code —
  // `bun run typecheck` runs this config alongside shared/api/web.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["bun"]
  },
  "include": ["scripts/**/*.ts"]
}
