# Copy to .env and adjust.  cp .env.example .env

# PostgreSQL (used by docker-compose and the app image)
POSTGRES_USER=enveo
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=enveo

# OPENAI_API_KEY enables the AI features (screenshot import, AI budget suggestions).
# Without it the app still works: suggestions fall back to local rules; screenshot import is AI-only and stays hidden.
OPENAI_API_KEY=
# gpt-5.5 = best screenshot-reading quality; gpt-5.4-mini = ~7x cheaper
OPENAI_MODEL=gpt-5.5

# Local development (api outside docker) — points at the docker-compose database:
# DATABASE_URL=postgres://enveo:change_this_password@127.0.0.1:5432/enveo

# --- Security (CORS + CSRF origin-guard) ---
# ALLOWED_ORIGINS = CSV of app origin(s) allowed for cross-origin mutations
# AND trusted for login (better-auth trusted origins). Same-origin browsing
# (Origin host == request Host) is always trusted automatically; add entries
# here only when the app is called from a DIFFERENT origin than it is served
# on. BETTER_AUTH_URL is also treated as an app origin. Empty = same-origin only.
# ALLOWED_ORIGINS=https://app.example.com

# --- Authentication (better-auth) ---
# Session secret — REQUIRED. Generate: openssl rand -hex 32
BETTER_AUTH_SECRET=
# Deployment profile: selfhost (default; registration closes after the first account) | cloud
#DEPLOYMENT=selfhost
# Reopen registration on selfhost (e.g. to add a family member), then remove again:
#ALLOW_SIGNUPS=1
# Public base URL of the app (origin). Required for OAuth redirects (Google);
# email+password login works without it on whatever origin the app is browsed
# on (same-host origins are trusted automatically, see ALLOWED_ORIGINS above).
# Set it to the public origin when a reverse proxy rewrites the Host header.
# BETTER_AUTH_URL=http://localhost:8080
# Google OAuth (Google Cloud console → OAuth 2.0 Client ID).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
