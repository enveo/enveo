{
  "name": "enveo",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun scripts/run-tests.ts",
    "test:db": "bun scripts/run-tests.ts --db",
    "typecheck": "bun run typecheck:shared && bun run typecheck:api && bun run typecheck:web && bun run typecheck:scripts",
    "typecheck:shared": "bun run --cwd packages/shared typecheck",
    "typecheck:api": "bun run --cwd packages/api typecheck",
    "typecheck:web": "bun run --cwd packages/web typecheck",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "lint": "biome check .",
    "lint:ci": "biome ci .",
    "lint:staged": "bun scripts/check-staged.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "hooks:install": "bun scripts/install-hooks.ts",
    "prepare": "bun scripts/install-hooks.ts",
    "build": "bun run build:web && bun run bundle:budget",
    "bundle:budget": "bun scripts/check-web-bundle.ts",
    "security:audit": "bun scripts/audit.ts",
    "eval:import": "bun scripts/evaluate-import-recognition.ts",
    "policy:sources": "bun scripts/check-sources.ts",
    "policy:web-security": "bun scripts/check-web-security.ts",
    "policy:docs": "diff -u CLAUDE.md AGENTS.md",
    "image:scan": "bun scripts/scan-image.ts",
    "image:inventory": "bun scripts/image-inventory.ts",
    "verify": "bun run typecheck && bun run lint && bun run test && bun run build && bun run policy:sources && bun run policy:web-security && bun run policy:docs",
    "verify:ci": "bun run typecheck && bun run lint:ci && bun run test:db && bun run build && bun run policy:sources && bun run policy:web-security && bun run policy:docs && bun run security:audit",
    "dev:api": "bun run --cwd packages/api dev",
    "dev:web": "bun run --cwd packages/web dev",
    "build:web": "bun run --cwd packages/web build",
    "db:generate": "bun run --cwd packages/api db:generate",
    "db:migrate": "bun run --cwd packages/api db:migrate",
    "db:seed": "bun run --cwd packages/api db:seed",
    "auth:reset-password": "bun run --cwd packages/api auth:reset-password"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/bun": "^1.3.14",
    "lefthook": "2.1.10",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "fast-uri": "3.1.6"
  }
}
